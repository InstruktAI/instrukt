#!/bin/sh
# instrukt repository commit check: the checks the staged files need, as
# .pre-commit-config.yaml assigns them by file pattern
# (docs/project/policy/testing.md); the functional suite runs in CI.
# Needs the pre-commit version in scripts/test-tools.env, shellcheck and the
# Rust toolchain. Enable once per clone with `make hooks`: pre-commit's own
# `install` refuses while core.hooksPath is set, so this file runs it.
set -e
# Linked worktrees build into the main checkout's target directory unless
# CARGO_TARGET_DIR says otherwise, so no worktree grows a target of its own;
# its cargo checks take that directory's lock (scripts/with-build-lock.sh).
if [ -z "${CARGO_TARGET_DIR:-}" ]; then
    common=$(git rev-parse --path-format=absolute --git-common-dir)
    CARGO_TARGET_DIR="$(dirname "$common")/target"
    export CARGO_TARGET_DIR
fi
# instrukt's own section (docs/project/spec/feature/repository/hook-sections.md),
# with the installed instrukt as in any adopting repository; it never changes
# the commit's result.
# >>> instrukt >>>
instrukt hooks run pre-commit "$@" || true
# <<< instrukt <<<
scripts/check-test-tool.sh pre-commit
exec pre-commit run --hook-stage pre-commit
