#!/bin/sh
# instrukt repository commit check: the checks the staged files need
# (project/instrukt/policy/testing), run by scripts/commit-checks.sh; the
# functional suite runs in CI. Enable once per clone with `make hooks`.
# instrukt's own section (project/instrukt/spec/feature/repository/hook-sections),
# with the installed instrukt as in any adopting repository: it stages what
# instrukt generates into the commit and never refuses the commit.
# >>> instrukt >>>
instrukt hooks run pre-commit "$@" || true
# <<< instrukt <<<
exec scripts/commit-checks.sh
