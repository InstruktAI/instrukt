#!/bin/sh
# instrukt repository checks: shellcheck, fmt, clippy, test
# (docs/project/policy/testing.md). Needs shellcheck, the Rust toolchain and
# the cargo-nextest version in scripts/test-tools.env.
# Enable once per clone with `make hooks`.
set -e
# Checkouts sharing one CARGO_TARGET_DIR take turns: the whole check runs
# under the target directory's lock (scripts/with-build-lock.sh).
# Linked worktrees build into the main checkout's target directory unless
# CARGO_TARGET_DIR says otherwise, so no worktree grows a target of its own.
if [ -z "${CARGO_TARGET_DIR:-}" ]; then
    common=$(git rev-parse --path-format=absolute --git-common-dir)
    CARGO_TARGET_DIR="$(dirname "$common")/target"
    export CARGO_TARGET_DIR
fi
if [ -z "${INSTRUKT_BUILD_LOCKED:-}" ]; then
    exec scripts/with-build-lock.sh "$0" "$@"
fi
shellcheck -x scripts/*.sh scripts/dev-instrukt .githooks/pre-commit
cargo fmt --all -- --check
cargo clippy --workspace --all-targets --locked -- -D warnings
scripts/check-test-tool.sh nextest
cargo nextest run --workspace --locked
cargo test --workspace --locked --doc
scripts/check-coverage.sh
