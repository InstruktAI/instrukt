{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/InstruktAI/instrukt/main/schemas/agents.schema.json",
  "title": "instrukt agent profiles",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "default": {
      "$ref": "#/$defs/role",
      "properties": {
        "order": {
          "type": "array"
        },
        "tier": {
          "type": "string"
        }
      }
    },
    "roles": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/role"
      }
    },
    "bundles": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/grant"
        }
      }
    },
    "profiles": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "order": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "tier": {
          "enum": [
            "light",
            "standard",
            "strong",
            "premium",
            null
          ]
        },
        "class": {
          "enum": [
            "focused",
            "standing",
            "agent"
          ]
        },
        "can": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "$ref": "#/$defs/grant"
              }
            ]
          }
        },
        "github_app": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "profile": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "codex"
            },
            "instance": {
              "type": "string",
              "minLength": 1
            },
            "light": {
              "$ref": "#/$defs/codex-chain"
            },
            "standard": {
              "$ref": "#/$defs/codex-chain"
            },
            "strong": {
              "$ref": "#/$defs/codex-chain"
            },
            "premium": {
              "$ref": "#/$defs/codex-chain"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "claude"
            },
            "instance": {
              "type": "string",
              "minLength": 1
            },
            "light": {
              "$ref": "#/$defs/claude-chain"
            },
            "standard": {
              "$ref": "#/$defs/claude-chain"
            },
            "strong": {
              "$ref": "#/$defs/claude-chain"
            },
            "premium": {
              "$ref": "#/$defs/claude-chain"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "antigravity"
            },
            "instance": {
              "type": "string",
              "minLength": 1
            },
            "light": {
              "$ref": "#/$defs/antigravity-chain"
            },
            "standard": {
              "$ref": "#/$defs/antigravity-chain"
            },
            "strong": {
              "$ref": "#/$defs/antigravity-chain"
            },
            "premium": {
              "$ref": "#/$defs/antigravity-chain"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "grok"
            },
            "instance": {
              "type": "string",
              "minLength": 1
            },
            "light": {
              "$ref": "#/$defs/grok-chain"
            },
            "standard": {
              "$ref": "#/$defs/grok-chain"
            },
            "strong": {
              "$ref": "#/$defs/grok-chain"
            },
            "premium": {
              "$ref": "#/$defs/grok-chain"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "kiro"
            },
            "instance": {
              "type": "string",
              "minLength": 1
            },
            "light": {
              "$ref": "#/$defs/kiro-chain"
            },
            "standard": {
              "$ref": "#/$defs/kiro-chain"
            },
            "strong": {
              "$ref": "#/$defs/kiro-chain"
            },
            "premium": {
              "$ref": "#/$defs/kiro-chain"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "pi"
            },
            "instance": {
              "type": "string",
              "minLength": 1
            },
            "light": {
              "$ref": "#/$defs/pi-chain"
            },
            "standard": {
              "$ref": "#/$defs/pi-chain"
            },
            "strong": {
              "$ref": "#/$defs/pi-chain"
            },
            "premium": {
              "$ref": "#/$defs/pi-chain"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "muse"
            },
            "instance": {
              "type": "string",
              "minLength": 1
            },
            "light": {
              "$ref": "#/$defs/muse-chain"
            },
            "standard": {
              "$ref": "#/$defs/muse-chain"
            },
            "strong": {
              "$ref": "#/$defs/muse-chain"
            },
            "premium": {
              "$ref": "#/$defs/muse-chain"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "opencode"
            },
            "instance": {
              "type": "string",
              "minLength": 1
            },
            "light": {
              "$ref": "#/$defs/opencode-chain"
            },
            "standard": {
              "$ref": "#/$defs/opencode-chain"
            },
            "strong": {
              "$ref": "#/$defs/opencode-chain"
            },
            "premium": {
              "$ref": "#/$defs/opencode-chain"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "fx"
            },
            "instance": {
              "type": "string",
              "minLength": 1
            },
            "light": {
              "$ref": "#/$defs/fx-chain"
            },
            "standard": {
              "$ref": "#/$defs/fx-chain"
            },
            "strong": {
              "$ref": "#/$defs/fx-chain"
            },
            "premium": {
              "$ref": "#/$defs/fx-chain"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "cursor"
            },
            "instance": {
              "type": "string",
              "minLength": 1
            },
            "light": {
              "$ref": "#/$defs/cursor-chain"
            },
            "standard": {
              "$ref": "#/$defs/cursor-chain"
            },
            "strong": {
              "$ref": "#/$defs/cursor-chain"
            },
            "premium": {
              "$ref": "#/$defs/cursor-chain"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "acpRegistry"
            },
            "instance": {
              "type": "string",
              "minLength": 1
            },
            "light": {
              "$ref": "#/$defs/acpRegistry-chain"
            },
            "standard": {
              "$ref": "#/$defs/acpRegistry-chain"
            },
            "strong": {
              "$ref": "#/$defs/acpRegistry-chain"
            },
            "premium": {
              "$ref": "#/$defs/acpRegistry-chain"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "not": {
            "required": [
              "kind"
            ]
          },
          "properties": {
            "instance": {
              "type": "string",
              "minLength": 1
            },
            "light": {
              "$ref": "#/$defs/inherited-kind-chain"
            },
            "standard": {
              "$ref": "#/$defs/inherited-kind-chain"
            },
            "strong": {
              "$ref": "#/$defs/inherited-kind-chain"
            },
            "premium": {
              "$ref": "#/$defs/inherited-kind-chain"
            }
          }
        }
      ]
    },
    "inherited-kind-chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "codex-chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "anyOf": [
              {
                "enum": [
                  "gpt-6-luna",
                  "gpt-6-sol",
                  "gpt-6.1-sol",
                  "gpt-6.2-astra"
                ]
              },
              {
                "type": "string"
              }
            ]
          },
          "serviceTier": {
            "enum": [
              "default",
              "priority",
              "flex"
            ]
          },
          "effort": {
            "enum": [
              "none",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              "ultra"
            ]
          }
        }
      }
    },
    "claude-chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "anyOf": [
              {
                "enum": [
                  "claude-haiku-5-5",
                  "claude-sonnet-5-5",
                  "claude-opus-5-5",
                  "claude-fable-5-2"
                ]
              },
              {
                "type": "string"
              }
            ]
          },
          "effort": {
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              "ultrathink"
            ]
          },
          "fastMode": {
            "type": "boolean"
          },
          "thinking": {
            "type": "boolean"
          },
          "contextWindow": {
            "enum": [
              "200k",
              "1m"
            ]
          }
        }
      }
    },
    "antigravity-chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "anyOf": [
              {
                "enum": [
                  "gemini-3.8-flash",
                  "gemini-4-neon"
                ]
              },
              {
                "type": "string"
              }
            ]
          },
          "effort": {
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh"
            ]
          }
        }
      }
    },
    "grok-chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "enum": [
              "none",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ]
          }
        }
      }
    },
    "kiro-chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "enum": [
              "none",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ]
          }
        }
      }
    },
    "pi-chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "enum": [
              "off",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ]
          }
        }
      }
    },
    "muse-chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "enum": [
              "none",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              "ultra"
            ]
          }
        }
      }
    },
    "opencode-chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "agent": {
            "type": "string"
          },
          "effort": {
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh"
            ]
          }
        }
      }
    },
    "fx-chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "enum": [
              "auto",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ]
          }
        }
      }
    },
    "cursor-chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "enum": [
              "none",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ]
          },
          "contextWindow": {
            "type": "string"
          },
          "fastMode": {
            "type": "boolean"
          },
          "thinking": {
            "type": "boolean"
          }
        }
      }
    },
    "acpRegistry-chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "effort": {
            "enum": [
              "none",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              "ultra",
              "ultrathink",
              "off",
              "auto"
            ]
          }
        }
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "scope"
      ],
      "properties": {
        "action": {
          "enum": [
            "docs-read",
            "docs-write",
            "todo-read",
            "todo-write",
            "bug-report",
            "artifact-read",
            "artifact-write",
            "stamp",
            "todo-orchestration",
            "assignment-write",
            "integration",
            "session-observe",
            "history-read",
            "standing-bind",
            "agents-read",
            "agents-write",
            "config-read",
            "config-write",
            "secrets-write",
            "repository-read",
            "repository-write",
            "code-commit",
            "publication",
            "code-check",
            "eval-read",
            "events-read",
            "installation-read",
            "installation-write",
            "runner-execute",
            "conversation-link"
          ]
        },
        "scope": {
          "enum": [
            "own",
            "any"
          ]
        }
      }
    }
  }
}
