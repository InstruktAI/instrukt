#!/bin/sh
# >>> other-tool >>>
other-tool run post-commit
# <<< other-tool <<<
# >>> instrukt >>>
instrukt hooks run post-commit "$@" || true
# <<< instrukt <<<
HOOK_NAME=post-commit exec sh -c 'echo ran >> "$(git rev-parse --git-dir)/own-hook-ran"'
